# ─────────────────────────────────────────────────────────
# DevFlow Forge — example environment
# Copy this file to apps/web/.env.local and fill in the values
# you actually need. Demo mode works with everything blank.
# ─────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────
# SQLite file. Resolved relative to apps/web/.
DATABASE_URL="file:./devflow.db"

# ── Auth / sessions ────────────────────────────────────
# 32+ random chars. Generate with:  openssl rand -hex 32
# In production this MUST be set; otherwise the server refuses to start.
SESSION_SECRET="change-me-to-a-long-random-32-char-string"

# Public URL of the app. Used for OAuth callback and cookie scope.
NEXTAUTH_URL="http://localhost:3000"

# Force-disable cookie `Secure` for local HTTPS-less production builds.
# Leave unset for normal use. Has no effect outside production.
# COOKIE_SECURE="false"

# At-rest key for encrypting GitHub access tokens. Optional — if unset,
# DevFlow derives one from SESSION_SECRET. Provide an explicit 32-byte
# hex string if you want to rotate SESSION_SECRET without invalidating
# every connected GitHub account.
# TOKEN_ENCRYPTION_KEY=""

# At-rest key for encrypting API keys in settings. Optional — if unset,
# DevFlow derives one from SESSION_SECRET. Same format as TOKEN_ENCRYPTION_KEY.
# SETTINGS_ENCRYPTION_KEY=""

# ── GitHub OAuth (required for GitHub login) ───────────
# Create at: https://github.com/settings/developers
#
# Device Flow setup:
#   Fill GITHUB_CLIENT_ID and leave GITHUB_CLIENT_SECRET blank.
#   Client IDs are public; secrets are not.
#
# Redirect Flow setup:
#   Fill both GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET and set callback URL:
#   ${NEXTAUTH_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# auto | device | redirect
# auto uses Device Flow when GITHUB_CLIENT_SECRET is blank.
GITHUB_OAUTH_MODE="auto"

# Default grants private repo import. Reduce to "read:user" if repo access is not needed.
GITHUB_OAUTH_SCOPE="repo read:org"

# Personal Access Token used as a fallback when no user is signed in
# (e.g. running workers headlessly). Optional.
# GITHUB_TOKEN=""

# ── AI runtime ─────────────────────────────────────────
# Three modes are supported and are switchable at runtime in /dashboard/settings:
#   demoMode=true        →   pre-recorded responses, zero cost
#   AI_RUNTIME=api       →   call an OpenAI-compatible HTTP endpoint
#   AI_RUNTIME=cli       →   spawn a local AI coding CLI (claude, opencode, codex, …)

DEMO_MODE="true"
AI_RUNTIME="api"

# ── API mode (OpenAI-compatible) ───────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o"
# Local servers (Ollama, LM Studio, vLLM) on localhost don't need a key.

# ── CLI mode ───────────────────────────────────────────
# Provider id. One of: claude-code | opencode | openai-codex | gemini-cli |
# aider | github-copilot | qwen-code | cursor-agent | custom
AI_CLI_PROVIDER="claude-code"

# Model passed to the CLI (provider-specific). Optional.
AI_CLI_MODEL=""

# read-only | workspace-write
AI_CLI_MODE="read-only"

# Absolute path to use as the CLI's cwd. If empty, DevFlow materializes a
# per-task workspace under storage/cli-workspaces/<taskId>/.
AI_CLI_WORKDIR=""

# Hard kill timeout for each CLI invocation, in seconds (15..1800).
AI_CLI_TIMEOUT_SECONDS="300"

# What happens when the CLI fails:  fail | api | demo
AI_CLI_FALLBACK="fail"

# Custom CLI bridge — used when AI_CLI_PROVIDER=custom.
# Args support templates: {{prompt}} {{promptFile}} {{mode}} {{model}}
# AI_CLI_CUSTOM_COMMAND="my-agent"
# AI_CLI_CUSTOM_ARGS='run "{{prompt}}" --mode {{mode}}'

# ── App ────────────────────────────────────────────────
NODE_ENV="development"
